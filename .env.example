# Copy to .env (never committed) and fill in what you need.
# Where the SQLite database lives (default data/leadfinder.db).
LEADFINDER_DB=data/leadfinder.db
# Host names the service answers to, comma separated (default: this machine's loopback names).
LEADFINDER_ALLOWED_HOSTS=
# The first manager account on a fresh database without demo data.
LEADFINDER_ADMIN_USER=
LEADFINDER_ADMIN_PASSWORD=
# Claude writes the first email and the call brief when a key is set; without one the templates do.
ANTHROPIC_API_KEY=
# Force one or the other: claude or template (default: claude when a key is set).
LEADFINDER_WRITER=
# The model Claude writes with (default claude-opus-5-5).
LEADFINDER_MODEL=
# When Claude's draft fails the checks, how many times it is rewritten, told what failed: 0 to 2 (default 0).
LEADFINDER_REVISIONS=
# The send step: off (default; an approval only marks the email ready) or dry-run (records approved emails in the
# outbox table and sends nothing). No real mail provider is agreed yet.
LEADFINDER_SENDER=
