# Copy to .env (never committed) and fill in what you need.
# Where the SQLite database lives (default data/leadfinder.db).
LEADFINDER_DB=data/leadfinder.db
# Host names the service answers to, comma separated (default: this machine's loopback names).
LEADFINDER_ALLOWED_HOSTS=
# The first manager account on a fresh database without demo data.
LEADFINDER_ADMIN_USER=
LEADFINDER_ADMIN_PASSWORD=
# Demo practices on a fresh database: synthetic (default) or npi (real practices from data/npi_practices.json).
LEADFINDER_PRACTICES=
# Who makes the research agent's decisions: claude or rules (default: claude when a key is set).
LEADFINDER_RESEARCH=
# Claude writes the first email and the call brief when a key is set; without one the templates do.
ANTHROPIC_API_KEY=
# Force one or the other: claude or template (default: claude when a key is set).
LEADFINDER_WRITER=
# The model Claude writes with (default claude-opus-5-5).
LEADFINDER_MODEL=
# Sending an approved email from its lead's page (service/mailer.py). Unset, the Send button is off.
# Every email goes to LEADFINDER_SMTP_TEST_TO, never to the practice; the subject says who it was for.
LEADFINDER_SMTP_USER=
# For Gmail: an app password (2-step verification on), not the account password.
LEADFINDER_SMTP_PASS=
LEADFINDER_SMTP_TEST_TO=
# Defaults: smtp.gmail.com, 587 (STARTTLS; 465 is SSL), and the user as the From address.
LEADFINDER_SMTP_HOST=
LEADFINDER_SMTP_PORT=
LEADFINDER_SMTP_FROM=
